# ==============================================================================
# Configurações do S3/R2 para Upload de Screenshots
# Copie este arquivo para .env (nesta pasta ou na raiz do projeto) e preencha os dados:
#   cp scripts/.env.example scripts/.env
# ==============================================================================

# Nome do Bucket S3 / R2 (Obrigatório)
S3_BUCKET_NAME="meu-bucket-de-screenshots"

# Região da AWS (Padrão: auto para Cloudflare R2 ou us-east-1 para AWS S3)
AWS_REGION="auto"

# Pasta base dentro do Bucket (Padrão: screenshots)
S3_FOLDER_PREFIX="screenshots"

# URL base pública da imagem (Opcional - útil se você usa CloudFront, Cloudflare R2 ou domínio próprio)
# Exemplo R2.dev: https://pub-xxxxxxxxxxxxxx.r2.dev
# Exemplo Custom Domain: https://img.meublog.com
S3_BASE_URL=""

# Endpoint URL customizado (Obrigatório para Cloudflare R2, MinIO ou DigitalOcean Spaces)
# Exemplo R2: https://<account_id>.r2.cloudflarestorage.com (Sem o nome do bucket no final)
# Exemplo MinIO: http://localhost:9000
S3_ENDPOINT_URL=""

# Credenciais da API S3
# IMPORTANTE para Cloudflare R2:
#   AWS_ACCESS_KEY_ID: deve ser o "Access Key ID" (32 caracteres hexadecimais)
#   AWS_SECRET_ACCESS_KEY: deve ser o "Secret Access Key" (64 caracteres hexadecimais)
#   (NÃO use o "Token Value" de 53 caracteres!)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
